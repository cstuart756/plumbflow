# Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/plumbflow?schema=public"

# Site URL
NEXT_PUBLIC_SITE_URL="https://plumbflow-app.herokuapp.com"

# Admin auth (single-admin password)
ADMIN_PASSWORD="change-me"
# Any long random string (>=32 chars recommended)
ADMIN_AUTH_SECRET="change-me-to-a-long-random-secret"

# Cron jobs
CRON_SECRET="change-me-to-a-long-random-secret"

# Stripe
# Create a Product + Price in Stripe, then paste the Price ID here (starts with price_...)
STRIPE_BOOKING_PRICE_ID=""
# Stripe secret key (starts with sk_...)
STRIPE_SECRET_KEY=""
# Stripe webhook signing secret (starts with whsec_...)
STRIPE_WEBHOOK_SECRET=""

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""

# CRM (choose one)
CRM_PROVIDER="hubspot"
HUBSPOT_API_KEY=""
PIPEDRIVE_API_KEY=""
SALESFORCE_INSTANCE_URL=""
SALESFORCE_ACCESS_TOKEN=""

# Email notifications
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
# API key from Mailgun (starts with key-...)
MAILGUN_API_KEY=""
# Sending domain configured in Mailgun
MAILGUN_DOMAIN=""
# Optional sender identity used in booking confirmations
MAIL_FROM="Plumbflow <onboarding@resend.dev>"

# Slack alerts
SLACK_WEBHOOK_URL=""

# SMS notifications
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
